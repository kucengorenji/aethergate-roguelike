{
  "name": "aethergate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --project=e2e",
    "e2e:update": "playwright test --project=e2e --update-snapshots",
    "perf": "pnpm build && node scripts/check-bundle-size.mjs && playwright test --project=perf",
    "assets": "node scripts/optimize-assets.mjs",
    "progress": "node scripts/progress/build-dashboard.mjs",
    "progress:verify": "node scripts/progress/record-verify.mjs && pnpm progress",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm e2e && pnpm perf",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@dimforge/rapier3d": "0.21.0",
    "lil-gui": "0.21.0",
    "miniplex": "2.0.0",
    "stats-gl": "4.2.3",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@gltf-transform/cli": "4.5.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "5.0.5"
  }
}
